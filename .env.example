PORT=3000
NODE_ENV=development
JWT_SECRET=development-secret-change-me

# MongoDB Atlas URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/mission_clean_patiala?retryWrites=true&w=majority

